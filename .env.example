# Copy this file to .env for local use. Never commit .env.
# On the live site, set these in Railway: your service > Variables.

# Kit: Settings > Developer > API key. Keep it secret. This is the only one you need.
KIT_API_KEY=

# Optional. The number at the end of a Kit form's address, e.g. 1234567.
# If set, new signups are also added to that form. Leave it out to add people
# straight to your Kit list.
KIT_FORM_ID=
