# Copy this file to .env for local use. Never commit .env.
# On the live site, set these in Railway: your service > Variables.

# Flodesk: Account settings > Integrations > API keys. Keep it secret. This is the only one you need.
FLODESK_API_KEY=

# Optional. The id of a Flodesk segment. If set, every new signup is added to that segment.
# A workflow that starts when someone joins a segment can then send the welcome email.
FLODESK_SEGMENT_ID=

# Optional. The id of a Flodesk workflow. If set, every signup is also started in that workflow
# straight away (use this instead of a segment trigger, or as well).
FLODESK_WORKFLOW_ID=
